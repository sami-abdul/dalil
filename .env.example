# Copy to .env and fill in. Never commit .env.

# Where the private document corpus lives. Defaults to ./corpus
DALIL_CORPUS_DIR=

# Zetaris, local free version
ZETARIS_BASE_URL=http://127.0.0.1:13000
ZETARIS_API_URL=http://127.0.0.1:8888
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ORG_ID=

# NVIDIA API, for parsing and embeddings
NVIDIA_API_KEY=
