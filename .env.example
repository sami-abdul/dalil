# Copy to .env and fill in, or keep the Zetaris values in a separate env file
# and point DALIL_ZETARIS_ENV at it. Never commit a real value.

# Where the private document corpus lives. Defaults to ./corpus
DALIL_CORPUS_DIR=

# Zetaris, local free version. The client signs in through the UI proxy.
DALIL_ZETARIS_ENV=
ZETARIS_UI_URL=http://127.0.0.1:13000
ZETARIS_ADMIN_EMAIL=
ZETARIS_ADMIN_PASSWORD=
# Or an API key created in the Zetaris UI, with the numeric organisation ID
ZETARIS_API_KEY=
ZETARIS_ORG_ID=

# NVIDIA API, for parsing and embeddings
NVIDIA_API_KEY=
